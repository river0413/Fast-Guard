# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）

# 监听地址：本机自测用 127.0.0.1；部署到云端服务器改为 0.0.0.0
FASTGUARD_HOST=127.0.0.1
FASTGUARD_PORT=1444

# SQLite 数据库文件路径（默认 cloud_backend/cloud_users.db）
# FASTGUARD_DB_PATH=cloud_users.db

# 预置管理员账号：首次启动自动创建，之后修改此项不会覆盖已有密码
FASTGUARD_ADMIN_USERNAME=admin
FASTGUARD_ADMIN_PASSWORD=Admin123

# 调试模式：会启用重载器并占用额外进程，绑定时请保持 false
FASTGUARD_DEBUG=false

# 登录失败限流：连续失败 FASTGUARD_MAX_FAILED_ATTEMPTS 次后锁定 LOCKOUT_SECONDS 秒
FASTGUARD_MAX_FAILED_ATTEMPTS=5
FASTGUARD_LOCKOUT_SECONDS=300
